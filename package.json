{
  "name": "vesium-lib",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Vue component and composition-api library for Cesium.",
  "license": "MIT",
  "homepage": "https://github.com/vesiumjs/vesium",
  "repository": {
    "url": "https://github.com/vesiumjs/vesium"
  },
  "llms": "https://vesium.js.org/llms.txt",
  "llmsFull": "https://vesium.js.org/llms-full.txt",
  "bugs": {
    "url": "https://github.com/vesiumjs/vesium/issues"
  },
  "keywords": [
    "vue",
    "cesium",
    "vueuse",
    "hooks",
    "composition-api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev packages --host",
    "docs:build": "npm run build:types && vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "build:types": "vue-tsc -p ./tsconfig.build.json --emitDeclarationOnly",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "pnpm test:e2e:docs && pnpm test:e2e:app",
    "test:e2e:docs": "vitepress build packages && start-server-and-test 'vitepress preview packages' http://localhost:4173 'cypress run --e2e --spec cypress/e2e/docs.cy.ts'",
    "test:e2e:app": "start-server-and-test 'vite e2e/app --port 4173 --strictPort' http://localhost:4173 'cypress run --e2e --spec cypress/e2e/app.cy.ts'",
    "test:e2e:dev": "start-server-and-test 'vitepress dev packages --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:e2e:app:dev": "start-server-and-test 'vite e2e/app --port 4173 --strictPort' http://localhost:4173 'cypress open --e2e --spec cypress/e2e/app.cy.ts'",
    "tsc": "vue-tsc --build --force",
    "eslint": "eslint . --fix",
    "taze": "taze",
    "release": "bumpp -r",
    "==========[CI/CD]===========": "",
    "build:ci": "tsdown",
    "publish:ci": "tsx ./scripts/publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@vesium/plot": "workspace:*",
    "@vueuse/core": "catalog:",
    "cesium": "catalog:",
    "vesium": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@iconify-json/svg-spinners": "catalog:",
    "@iconify-json/tabler": "catalog:",
    "@iconify/utils": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/markdown-it-container": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "bumpp": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "fast-glob": "catalog:",
    "gray-matter": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lightningcss": "catalog:",
    "lint-staged": "catalog:",
    "local-pkg": "catalog:",
    "magic-string": "catalog:",
    "markdown-it": "catalog:",
    "markdown-it-container": "catalog:",
    "pinia": "catalog:",
    "sass": "catalog:",
    "start-server-and-test": "catalog:",
    "svgo": "catalog:",
    "taze": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-cesium": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-vue": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llmstxt": "catalog:",
    "vitest": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}
